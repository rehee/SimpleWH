# Used only to create the owner on the first startup. No default password.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# true for HTTPS through Cloudflare; false only for local HTTP preview.
COOKIE_SECURE=false
CLOUDFLARE_TUNNEL_TOKEN=
BIND_ADDRESS=127.0.0.1
APP_PORT=6001
# Published by .github/workflows/publish-image.yml; may also use a sha-... tag.
APP_IMAGE=ghcr.io/rehee/simplewh:latest
